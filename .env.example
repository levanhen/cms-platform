# PostgreSQL password used by docker-compose.yml (must match DATABASE_URL)
POSTGRES_PASSWORD=cms

# Database (docker-compose maps host 5433 → container 5432)
DATABASE_URL=postgresql://cms:cms@127.0.0.1:5433/cms?schema=public

# Redis (docker-compose maps host 6380 → container 6379)
REDIS_URL=redis://127.0.0.1:6380

# Auth (apps/bo-cms)
AUTH_SECRET=change-me-to-a-long-random-string
# Local:  http://localhost:3000
# Prod:   http://YOUR_IP:3010  (or https://admin.example.com)
AUTH_URL=http://localhost:3000

# Super Admin seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=Super Admin

# Storage (relative to monorepo root — shared by BO + web)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=apps/bo-cms/uploads
MAX_UPLOAD_SIZE_MB=20

# Apps
NEXT_PUBLIC_APP_NAME=CMS
# Public web URL — apps/web (SEO) + the "Xem website" (View website) link in the apps/bo-cms header
# Local:  http://localhost:3001
# Prod:   http://YOUR_IP:3011  (or https://www.example.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# BO calls the web revalidate endpoint — prefer loopback on the same host
# Local:  http://localhost:3001/api/revalidate
# Prod:   http://127.0.0.1:3011/api/revalidate
WEB_REVALIDATE_URL=http://localhost:3001/api/revalidate
REVALIDATE_SECRET=change-me-revalidate-secret

# SMTP (apps/web contact form → sends to the contact_email setting)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CMS Contact <noreply@example.com>"
